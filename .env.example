# Copy to .env (gitignored) and fill in before `docker compose up`.
# These are read by compose.yaml itself (variable substitution), not by any app directly.

# harness-server LLM provider: gemini (default, free tier) or anthropic. Only the active
# provider's key is required -- GEMINI_API_KEY is unused if LLM_PROVIDER=anthropic, and
# vice versa. Vector embeddings (pay_for_checkout_session, recall_past_purchases) are
# unaffected by this choice -- see EMBEDDING_MODEL below, a different model family entirely.
LLM_PROVIDER=gemini
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.5-flash-lite
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-5-5

# preferences: MongoDB Atlas connection string. Atlas Vector Search isn't available
# against a local mongod, so this can't be self-hosted by compose. harness-server also uses
# this (and MONGODB_DB) to dump the raw conversation transcript after every purchase, into
# a plain "conversation_transcripts" collection -- no vector search needed for that part, but
# reusing the same cluster/db is simplest.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/
MONGODB_DB=agentic_commerce

# Voyage AI model MongoDB Atlas Vector Search's Automated Embedding uses for
# pay_for_checkout_session / recall_past_purchases -- generated and stored entirely
# server-side by Atlas, not called from either app. Requires a Voyage AI key configured
# on the Atlas cluster itself (Atlas UI, not here).
EMBEDDING_MODEL=voyage-4
