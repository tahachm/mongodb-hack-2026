# Copy to .env (gitignored) and fill in before `docker compose up`.
# These are read by compose.yaml itself (variable substitution), not by any app directly.

# harness-server LLM provider: gemini (default, free tier) or anthropic.
LLM_PROVIDER=gemini
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.5-flash-lite
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-5-5

# pay_for_checkout_session always embeds preference_notes via Gemini regardless of
# LLM_PROVIDER -- GEMINI_API_KEY above is required even when using anthropic for chat.
EMBEDDING_MODEL=text-embedding-004

# preferences: MongoDB Atlas connection string. Atlas Vector Search isn't available
# against a local mongod, so this can't be self-hosted by compose.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/
MONGODB_DB=agentic_commerce
EMBEDDING_DIMENSIONS=768
