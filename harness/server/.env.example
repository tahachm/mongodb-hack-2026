# Copy this to .env.local for real secrets (gitignored, wins over .env) -- same convention
# Vite uses on the client side. .env is for committed, non-secret defaults, if ever needed.

PORT=4000

# gemini (default) or anthropic
LLM_PROVIDER=gemini

# Gemini: free tier, no card needed -- https://aistudio.google.com/apikey
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.5-flash-lite

# Anthropic: pay-per-token, separate from a Claude.ai subscription -- https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-5-5

# ACP tools: id=url pairs, comma-separated. One entry per running merchant/ process.
# Unset/empty is valid -- plain chat still works, shopping tools just report no merchants.
MERCHANT_URLS=mall-wart=http://127.0.0.1:8080
PSP_URL=http://127.0.0.1:8081
PREFERENCES_URL=http://127.0.0.1:8083

# pay_for_checkout_session / recall_past_purchases send raw text to the preferences service;
# MongoDB Atlas Vector Search's Automated Embedding (Voyage AI) generates the vectors entirely
# server-side. Nothing to configure here -- see preferences/.env for its own EMBEDDING_MODEL.
